+        // c<slot>[word] + K, through additions of constants and copies.
+        private static bool TryCbufPlusConst(Operand o, out int slot, out int word, out int k)
+        {
+            slot = word = k = 0;
+            for (int depth = 0; depth < 8; depth++)
+            {
+                if (o.Type == OperandType.ConstantBuffer)
+                {
+                    slot = o.GetCbufSlot();
+                    word = o.GetCbufOffset();
+                    return true;
+                }
+
+                if (o.AsgOp is not Operation op)
+                {
+                    return false;
+                }
+
+                if (op.Inst == Instruction.Copy)
+                {
+                    o = op.GetSource(0);
+                }
+                else if (op.Inst == Instruction.Add && op.GetSource(1).Type == OperandType.Constant)
+                {
+                    k += op.GetSource(1).Value;
+                    o = op.GetSource(0);
+                }
+                else if (op.Inst == Instruction.Add && op.GetSource(0).Type == OperandType.Constant)
+                {
+                    k += op.GetSource(0).Value;
+                    o = op.GetSource(1);
+                }
+                else
+                {
+                    return false;
+                }
+            }
+
+            return false;
+        }
