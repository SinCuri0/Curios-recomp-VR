+        // An LDC at a run-time address (InstEmitMemory Ldc): vecIndex = ((srcA + imm) >> 2 [+ word]) >> 2. Returns
+        // srcA + imm, the byte address, for the low word only (an even word of a 64-bit read).
+        private static bool TryConstantBufferByteAddress(Operand vecIndex, out Operand byteAddress)
+        {
+            byteAddress = null;
+            if (vecIndex.AsgOp is not Operation shr || shr.Inst != Instruction.ShiftRightU32 ||
+                shr.GetSource(1).Type != OperandType.Constant || shr.GetSource(1).Value != 2)
+            {
+                return false;
+            }
+
+            Operand words = shr.GetSource(0);
+            if (words.AsgOp is Operation add && add.Inst == Instruction.Add && add.GetSource(1).Type == OperandType.Constant)
+            {
+                if (add.GetSource(1).Value != 0)
+                {
+                    return false;   // the high word of a 64-bit read: its low word is noted
+                }
+
+                words = add.GetSource(0);
+            }
+
+            if (words.AsgOp is not Operation shr2 || shr2.Inst != Instruction.ShiftRightU32 ||
+                shr2.GetSource(1).Type != OperandType.Constant || shr2.GetSource(1).Value != 2)
+            {
+                return false;
+            }
+
+            byteAddress = shr2.GetSource(0);
+            return true;
+        }
