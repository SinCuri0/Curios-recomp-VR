+        // LOCAL TEST (Ocarina), ported from Fritchii 8262db06f and 749e026c1: the exact pointers a guarded access can
+        // reach, which the runtime puts first in its list of candidates (vk_exec_draw.c dyn_collect, "ptrhint" notes):
+        //   "ptrhint i <slot> <word> <K>": the pointer is loaded from memory at K bytes past the pointer in c<slot>[word].
+        //     Ocarina's culling passes read their instance tables this way; unlisted, every instance was culled.
+        //   "ptrhint a <slot> <first> <stride>": the pointer is read from c<slot> at a run-time byte offset first + i * stride
+        //     (one table per object type); every slot of the array is a candidate.
+        // Phis and selects of the address and of the array offset are followed, as Fritchii does.
+        private static void NotePointerForms(ResourceManager resourceManager, IGpuAccessor gpuAccessor, Operand address)
+        {
+            HashSet<string> notes = [];
+            Queue<Operand> pending = new();
+            HashSet<Operand> seen = [];
+            pending.Enqueue(address);
+            while (pending.TryDequeue(out Operand o))
+            {
+                if (!seen.Add(o) || seen.Count > 4096)
+                {
+                    continue;
+                }
+
+                if (o.AsgOp is PhiNode phi)
+                {
+                    for (int i = 0; i < phi.SourcesCount; i++)
+                    {
+                        pending.Enqueue(phi.GetSource(i));
+                    }
+
+                    continue;
+                }
+
+                if (o.AsgOp is not Operation op)
+                {
+                    continue;
+                }
+
+                // A global load turned into a call of its storage helper: Call(id, address low, address high).
+                if (op.Inst == Instruction.Call && op.SourcesCount >= 3 &&
+                    TryCbufPlusConst(op.GetSource(1), out int slot, out int word, out int k) && k >= 0 && (k & 7) == 0)
+                {
+                    notes.Add($"ptrhint i {slot} {word} {k}");
+                }
+                else if (op.Inst == Instruction.Load && op.StorageKind == StorageKind.ConstantBuffer && op.SourcesCount >= 3 &&
+                         op.GetSource(0).Type == OperandType.Constant &&
+                         resourceManager.TryGetConstantBufferSlot(op.GetSource(0).Value, out int cslot) &&
+                         TryConstantBufferByteAddress(op.GetSource(2), out Operand byteAddress))
