+                        {
+                            notes.Add($"ptrhint a {cslot} {first} {stride}");
+                        }
+                    }
+                }
+
+                for (int i = 0; i < op.SourcesCount; i++)
+                {
+                    pending.Enqueue(op.GetSource(i));
+                }
+            }
+
+            foreach (string note in notes)
