+        // Fritchii CollectPointerSlots/DynamicPointerSlots: (x << s) + base or x * stride + base gives (base, stride);
+        // a constant gives (value, 0); phis and selects contribute each input.
+        private static void CollectPointerSlots(Operand offset, List<(int First, int Stride)> slots, HashSet<Operand> visited, int depth)
+        {
+            if (depth > 16 || slots.Count >= 8)
+            {
+                return;
+            }
+
+            if (offset.Type == OperandType.Constant)
+            {
+                if (!slots.Contains((offset.Value, 0)))
+                {
+                    slots.Add((offset.Value, 0));
+                }
+
+                return;
+            }
+
+            if (!visited.Add(offset))
+            {
+                return;
+            }
+
+            if (offset.AsgOp is PhiNode phi)
+            {
+                for (int i = 0; i < phi.SourcesCount; i++)
+                {
+                    CollectPointerSlots(phi.GetSource(i), slots, visited, depth + 1);
+                }
+
+                return;
+            }
+
+            if (offset.AsgOp is not Operation op)
+            {
+                return;
+            }
+
+            int Stride(Operand v)
+            {
+                if (v.AsgOp is Operation s && s.SourcesCount == 2 && s.GetSource(1).Type == OperandType.Constant)
+                {
+                    if (s.Inst == Instruction.ShiftLeft && s.GetSource(1).Value is >= 0 and < 16)
+                    {
+                        return 1 << s.GetSource(1).Value;
+                    }
+
+                    if (s.Inst == Instruction.Multiply)
+                    {
+                        return s.GetSource(1).Value;
+                    }
+                }
+
+                return 0;
+            }
+
+            switch (op.Inst)
+            {
+                case Instruction.Copy:
+                    CollectPointerSlots(op.GetSource(0), slots, visited, depth + 1);
+                    return;
+                case Instruction.ConditionalSelect:
+                    CollectPointerSlots(op.GetSource(1), slots, visited, depth + 1);
+                    CollectPointerSlots(op.GetSource(2), slots, visited, depth + 1);
+                    return;
+            }
+
+            int stride = Stride(offset);
+            if (stride >= 8)
+            {
+                if (!slots.Contains((0, stride)))
+                {
+                    slots.Add((0, stride));
+                }
+
+                return;
+            }
+
+            if (op.Inst == Instruction.Add)
+            {
+                for (int arg = 0; arg < 2; arg++)
+                {
+                    Operand c = op.GetSource(arg ^ 1);
+                    int s = Stride(op.GetSource(arg));
+                    if (c.Type == OperandType.Constant && s >= 8 && !slots.Contains((c.Value, s)))
+                    {
+                        slots.Add((c.Value, s));
+                        return;
+                    }
+                }
+            }
+        }
